---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
  <a href={`/projects/${project.slug}`}>
    {project.data.image && (
      <img src={project.data.image} alt={project.data.title}
           class="w-full h-48 object-cover" />
    )}
    <div class="p-5">
      <h3 class="font-semibold mb-2 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        {project.data.title}
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-3">{project.data.description}</p>
      {project.data.tech.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {project.data.tech.map((t) => (
            <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
              {t}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
