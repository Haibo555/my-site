<div class="relative w-full max-w-md">
  <input type="text" id="search-input" placeholder="搜索文章..."
         class="w-full px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-sm
                focus:outline-none focus:ring-2 focus:ring-blue-500 transition-shadow" />
  <div id="search-results" class="absolute top-full mt-2 w-full bg-white dark:bg-gray-900 border border-gray-200
    dark:border-gray-700 rounded-lg shadow-lg hidden max-h-80 overflow-y-auto z-50"></div>
</div>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLDivElement;

  input?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    if (query.length < 2) {
      results.classList.add('hidden');
      return;
    }

    try {
      // @ts-ignore - Pagefind loaded via postbuild script
      const pagefind = await import('/pagefind/pagefind.js');
      const search = await pagefind.search(query);
      const items = search.results.slice(0, 8);

      if (items.length === 0) {
        results.innerHTML = '<p class="p-4 text-sm text-gray-500">没有找到结果</p>';
      } else {
        results.innerHTML = (await Promise.all(items.map(async (r: any) => {
          const data = await r.data();
          return `<a href="${data.url}" class="block p-3 hover:bg-gray-50 dark:hover:bg-gray-800 border-b
            border-gray-100 dark:border-gray-800 last:border-0">
            <span class="text-sm font-medium">${data.meta?.title || data.url}</span>
            <span class="text-xs text-gray-500 block truncate">${data.excerpt || ''}</span>
          </a>`;
        }))).join('');
      }
      results.classList.remove('hidden');
    } catch {
      results.innerHTML = '<p class="p-4 text-sm text-gray-500">搜索功能不可用（需要先构建页面索引）</p>';
      results.classList.remove('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    if (!input?.contains(e.target as Node) && !results?.contains(e.target as Node)) {
      results?.classList.add('hidden');
    }
  });
</script>
